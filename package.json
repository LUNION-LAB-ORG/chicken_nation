{
  "name": "chicken-nation-web",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "node node_modules/eslint/bin/eslint.js app components features lib",
    "lint:fix": "node node_modules/eslint/bin/eslint.js app components features lib --fix",
    "type-check": "bun tsc --noEmit",
    "test": "bun test",
    "controle": "node scripts/controle-site.mjs",
    "budget": "node scripts/budget-js.mjs",
    "build:analyze": "ANALYZE=true bun build",
    "vercel-build": "bun run --bun build",
    "security-audit": "bun run --bun audit --audit-level moderate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.89.0",
    "ak-api-http": "^1.0.3",
    "ak-zod-form-kit": "^1.0.5",
    "axios": "^1.20.0",
    "clsx": "2.1.1",
    "jotai": "^2.14.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.63.0",
    "resend": "^6.32.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "20.5.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "8.34.1",
    "baseline-browser-mapping": "^2.11.0",
    "eslint": "9.25.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "16.0.0",
    "postcss": "8.5.29",
    "prettier": "3.5.3",
    "tailwind-variants": "3.1.1",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    }
  }
}
